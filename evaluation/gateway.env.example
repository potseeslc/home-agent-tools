# Copy OUTSIDE the repository, chmod 600, replace every REPLACE value.
HOST=0.0.0.0
PORT=4444
APP_DOMAIN=http://localhost:4444
DATABASE_URL=sqlite:////app/data/mcp.db
JWT_SECRET_KEY=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET
AUTH_ENCRYPTION_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET
BASIC_AUTH_PASSWORD=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET
PLATFORM_ADMIN_EMAIL=evaluation-admin@example.com
PLATFORM_ADMIN_PASSWORD=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET
AUTH_REQUIRED=true
MCP_CLIENT_AUTH_ENABLED=true
MCPGATEWAY_UI_ENABLED=true
MCPGATEWAY_ADMIN_API_ENABLED=true
SSO_ENABLED=true
SSO_GENERIC_ENABLED=true
SSO_GENERIC_PROVIDER_ID=pocketid
SSO_GENERIC_DISPLAY_NAME=Pocket ID
SSO_GENERIC_CLIENT_ID=REPLACE_WITH_CLIENT_ID
SSO_GENERIC_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET
SSO_GENERIC_AUTHORIZATION_URL=https://id.example.com/authorize
SSO_GENERIC_TOKEN_URL=https://id.example.com/api/oidc/token
SSO_GENERIC_USERINFO_URL=https://id.example.com/api/oidc/userinfo
SSO_GENERIC_ISSUER=https://id.example.com
SSO_GENERIC_JWKS_URI=https://id.example.com/.well-known/jwks.json
SSO_GENERIC_SCOPE=openid profile email groups
SSO_GENERIC_ADMIN_GROUPS=["hat-evaluation"]
SSO_GENERIC_DEFAULT_ROLE=platform_viewer
SSO_AUTO_CREATE_USERS=true
# Local SSH-tunnel evaluation only. Use HTTPS + secure cookies for deployment.
SECURE_COOKIES=false
SSRF_PROTECTION_ENABLED=true
# This release validates browser callback URLs with its outbound SSRF rules.
# Required for the localhost OAuth callback; not a production recommendation.
SSRF_ALLOW_LOCALHOST=true
SSRF_ALLOW_PRIVATE_NETWORKS=false
# Add only the Home Assistant host /32; match the adapter IP in compose.
SSRF_ALLOWED_NETWORKS=["172.30.240.2/32"]
GUNICORN_WORKERS=1
LOG_LEVEL=WARNING
# Evaluated but did not enforce additionalProperties=false for this REST tool.
EXPERIMENTAL_VALIDATE_IO=true
