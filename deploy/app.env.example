# Keep the populated copy outside Git, mode 0600.
HAT_GATEWAY_URL=http://hat-eval-gateway:4444
HAT_PUBLIC_URL=http://localhost:4444
HAT_OIDC_ORIGIN=https://id.example.com
HAT_SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Stable local user UUIDs from the authenticated broker, not email addresses.
# Do not enable unprovisioned users; this first release is a single-operator preview.
HAT_ALLOWED_USER_IDS=REPLACE_WITH_EXPLICIT_USER_UUID
HAT_STATE_PATH=/data/hat.sqlite
